---
import Money from "../Icons/Money.astro";
import Rocket from "../Icons/Rocket.astro";
import RoundedSpain from "../Icons/RoundedSpain.astro";
import Button from "./Ebook/Button.astro";
import ImagenSection from '../../public/iamges/image-section-calidad.svg';
import Mountains from "./Decorations/Mountains.astro";
import ArrowRight from "../Icons/Ebook/ArrowRight.astro";
import { Image } from "astro:assets";
import Arrow from "../assets/flecha.svg"



---
<section class="w-full bg-[#f6f9fc] py-10 relative">
    <Mountains/>
    <div class="text-center md:pt-20 md:max-w-3xl mx-auto px-[16px] md:px-4 flex flex-col justify-center items-center">
        <header class="pb-5">
            <h3 class="title-section text-[#213343] md:title-section-desk">ERES <span class="bg-[#C6DBEC] inline-block font-bold">DUEÑO DE UN CONSULTORIO DENTAL</span></h3>
            <p class="title-section text-[#364b4b] md:title-section-desk">PERO TU CLÍNICA NO GANA LO QUE DEBERÍA</p>
        </header>
        <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">No es porque tus tratamientos sean malos.</span>
        </p>
        <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">👉Es porque no sabes conseguir  <span class="bg-[#C6DBEC] inline-block font-bold">pacientes online.</span></span>
        </p>
        <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">Quieres abrir tu <span class="bg-[#C6DBEC] inline-block font-bold">segunda clínica,</span></span>
            <span class="block leading-[1.2] mb-1">pero la primera <span class="bg-[#C6DBEC] inline-block font-bold"> apenas es rentable.</span></span>
        </p>
        <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">Facturas <span class="bg-[#C6DBEC] inline-block font-bold"> 10.000€ al mes,</span></span>
            <span class="block leading-[1.2] mb-1">cuando una clínica como la tuya <span class="bg-[#C6DBEC] inline-block font-bold">  debería estar en 30.000€+.</span></span>
        </p>
        <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">✅Tus tratamientos son buenos. ✅Tu equipo es bueno.</span>
            <span class="block leading-[1.2]"> <span class="bg-[#C6DBEC] inline-block font-bold"> Pero eso no es suficiente en el 2026</span></span>
        </p>
            <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
            <span class="block leading-[1.2] mb-1">Hazte la siguiente pregunta:</span>
            <span class="block leading-[1.2]">👉¿Cómo vas a abrir 3 clínicas si <span class="bg-[#C6DBEC] inline-block font-bold"> no sabes llenar una?</span></span>
        </p>
        <picture class="w-full">
            <Image src={ImagenSection} alt={''}/>
        </picture>

        <div class="px-8 py-10 border-1 border-[#9ca3af] bg-[#ffffff] rounded-lg w-[120%]">
            <h3 class="font-oswald font-bold uppercase text-[28px] text-[#213343] mb-6" >El problema de ser un odontologo en el 2026:</h3>
                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">Hoy <span class="bg-[#C6DBEC] inline-block font-bold">ya no basta con ser buen odontólogo</span>.</span>
                    <span class="block leading-[1.2] ">Eso <span class="bg-[#C6DBEC] inline-block font-bold">ya no te diferencia.</span> </span>
                </p>
                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">Hacer bien tu trabajo <span class="bg-[#C6DBEC] inline-block font-bold">no garantiza pacientes nuevos.</span></span>
                    <span class="block leading-[1.2]">Y mucho menos crecimiento.</span>
                </p>
                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">La mayoría de clínicas hacen lo mismo:</span>
                    <span class="block leading-[1.2]">❌ Publicidad genérica ❌ Mensajes sin estrategia ❌ Venden Precio en lugar de calidad</span>
                </p>
                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">En el 2026 <span class="bg-[#C6DBEC] inline-block font-bold">no gana la mejor clínica</span>,</span>
                    <span class="block leading-[1.2]">gana la que tiene una <span class="bg-[#C6DBEC] inline-block font-bold">estrategia de marketing rentable.</span></span>
                </p>

                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1"><span class="bg-[#C6DBEC] inline-block font-bold"> El marketing genérico NO funciona </span> en clínicas dentales</span>
                </p>
                <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] font-bold">👉 Necesitas marketing dental hecho por expertos.</span>
                </p>
            <div class="flex md:flex-row flex-col items-center gap-4 justify-center">
                <picture class="">
                    <img src="../iamges/imagen x derecha.svg" alt="" class="block w-[250px] h-[350px]" loading="lazy"/>
                </picture>
                <span class="rotate-[90deg] md:rotate-[0deg]">
                    <Image src={Arrow} alt="" class="w-15"/>
                </span>
                <picture class="">
                    <img src="../iamges/imagen-odo-2026-izquierda-2.svg" alt="" class="block w-full h-[390px]" loading="lazy" />
                </picture>
            </div>

            <Button width="w-full" mdWidth="w-full" useArrow={false} subtext="ES 100% GRATIS DURANTE FEBRERO">
                <span class="text-[.7rem] md:text-[24px]">Si, quiero resolver esos problemas este 2026</span>
            </Button>
        </div>

        <div class="py-10 px-4 mt-4 border-[#9ca3af] bg-[#ffffff] border-1 rounded-lg w-[120%]">
            <h3 class="font-oswald font-bold uppercase text-[28px] text-[#213343] mb-6">Mi propuesta para ti:</h3>
            <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">Trabaja con un <span class="bg-[#C6DBEC] inline-block font-bold">especialista en marketing dental.</span></span>
                    <span class="block leading-[1.2]">No con una agencia genérica.</span>
                    <span class="block leading-[1.2] mb-1"><span class="bg-[#C6DBEC] inline-block font-bold">Conmigo</span>, fundador de <span class="bg-[#C6DBEC] inline-block font-bold">HackDental.</span></span>

            </p> 
            <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">Mi trabajo es <span class="bg-[#C6DBEC] inline-block font-bold">diagnosticar exactamente</span></span>
                    <span class="block leading-[1.2]">por qué tu clínica <span class="bg-[#C6DBEC] inline-block font-bold"> no está creciendo</span></span>
                    <span class="block leading-[1.2]">y qué está bloqueando tus ventas hoy.</span>
            </p> 
             <p class="text-[#213343] md:text-[21px] text-[18px] mb-[18px]">
                    <span class="block leading-[1.2] mb-1">No es una llamada comercial.</span>
                    <span class="block leading-[1.2]">Es un <span class="bg-[#C6DBEC] inline-block font-bold">Es un análisis estratégico </span> de tu marketing y tu captación.</span>
            </p> 


            <div class="flex md:flex-row flex-col items-center gap-4 justify-center mb-[40px]">
                <div class="px-8 py-4 rounded-[60px] bg-[#d2ebeb] flex flex-col ">
                    <span class="font-oswald text-[21px] font-bold text-[#2c3642]">ANTES</span>
                    <picture>
                        <img src="../iamges/imagen x derecha.svg" alt="" class="block w-[230px] h-[230px]" loading="lazy"/>
                    </picture>
                </div>
                <span class="rotate-[90deg] md:rotate-[0deg]">
                    <Image src={Arrow} alt="" class="w-15"/>
                </span>
                <div class="px-8 py-4 rounded-[60px] bg-[#d2ebeb] flex flex-col ">
                    <span class="font-oswald text-[21px] font-bold text-[#2c3642]">DESPUES</span>
                    <picture>
                        <img src="../iamges/imagen-odo-2026-derecha.svg" alt="" class="block w-[250px] h-[250px]" loading="lazy"/>
                    </picture>
                </div>
            </div>
            <Button width="w-full" mdWidth="md:w-full" useArrow={false} subtext="ES 100% GRATIS DURANTE FEBRERO">
                <span class="text-[.7rem] md:text-[24px]">QUIERO UNA AUDITORIA DE MARKETING</span>
            </Button>

            <span class="font-inter font-semibold md:text-[21px] text-[18px] mt-[32px] mb-[20px] text-[#213343] block"> Aplica ahora si tu consultorio dental cumple lo siguiente:</span>

            <div class="flex flex-col md:flex-row items-center text-[#213343] justify-center gap-4 mb-[20px] bg-[#086969]/10 rounded-xl">
                <div class="flex gap-3  items-center px-3 py-6">
                    <div>
                        <span class="block font-inter font-medium text-[17px] text-start">Ubicados en</span>
                        <span class="block font-oswald font-bold text-[24px] text-start leading-[0.8]">España</span>
                    </div>
                        <RoundedSpain size="40"/>
                </div>
                <div class=" flex gap-3 items-center md:border-x-1 md:border-y-0 border-x-0 border-y-1 border-gray-500/40 px-6 py-6">
                    <div>
                        <span class="block font-inter font-medium text-[17px] text-start">Facturan mas de</span>
                        <span class="block font-oswald font-bold text-[24px] text-start leading-[0.8]"><b>10,000 euros</b></span>
                    </div>
                    <Money size="40" color="#eab308"/>
                </div>
                <div class=" flex gap-3 items-center px-3 py-6">
                    <div>
                        <span class="block font-inter font-medium text-[17px] text-start">Busca crecer en</span>
                        <span class="block font-oswald font-bold text-[24px] text-start leading-[0.8]"><b>2026</b></span>
                    </div>
                    <Rocket size="40" color="#ea580c"/>
                </div>
            </div>

        </div>
        
    </div>
</section>

<script>
const buttonMobile = document.getElementById('button-mobile') as HTMLButtonElement
const buttonDesktop = document.getElementById('button-desk') as HTMLButtonElement

const widthOfWindow = window.innerWidth;

const isMobile = widthOfWindow <= 780
const isDektop = widthOfWindow >= 1024

if(isMobile) {
    buttonMobile.classList.remove('hidden')
    buttonDesktop.classList.add('hidden')
}

if(isDektop){
    buttonMobile.classList.add('hidden')
    buttonDesktop.classList.remove('hidden')
}


</script>