---
import AlertTriangle from '../../Icons/Ebook/AlertTriangle.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import Ebook from '../../assets/Ebook/ebook (3).svg'
---

<section class="relative text-white overflow-hidden pb-20 md:pb-40 bg-[#151719]">
  <span class="font-logo text-white/80 text-center text-[1.7rem] block pt-10 mb-[16px]">HackDental</span>
  <div class="md:max-w-[70%] mx-auto px-4 pt-8 md:pt-12 relative z-10 mb-8 md:mb-12">
    <div class="flex flex-col md:flex-row gap-5 md:gap-12 items-center">
      <figure class="w-full relative transform transition-all duration-500 hover:scale-105 hover:-translate-y-2 cursor-pointer  grid place-items-center basis-2/5">
          <Image src={Ebook} alt={''} class={'w-full h-full'} />
      </figure>
      <div class="space-y-6 md:space-y-8 md:order-2 text-center md:text-left  basis-3/5">
        <div class="m-0 mb-[20px]">
          <p class="text-brand-red font-bold uppercase  mb-1 text-sm md:text-lg flex items-center justify-center md:justify-start gap-2">
            <span class="opacity-90">MENSAJE URGENTE</span>
          </p>
          <h1 class="title-hero md:mb-[24px] mb-4 text-[#ebf1f5]">
            Hola soy jose Whittembury.
            <br>
            Tengo un regalo para ti

          </h1>
        </div>
        <p class="text-gray text-[18px]">Soy el fundador de HackDental, y tengo la mision clara: <br>ayudar a clinicas dentales independientes </p>

        <p class="text-gray text-[18px]">No me parece justo que odontologos talentosos sean aplastados por <br> grandes franquicias. De verdad, no es justo.</p>
        <p class="text-gray text-[18px]">Por eso tengo un <span class="text-white">regalo</span>  para <span class="text-white">quienes lean el ebook:</span> </p>
        <div class="flex gap-4 items-center justify-start w-full">
          <span class="p-2 py-0 text-lg rounded-lg bg-[#11302e] text-[#066c6c]">✔</span>
          <span class=" traking-wide font-inter text-white text-[18px]">Una auditoria de marketing gratis para tu clinica dental.</span>
        </div>
        <p class="text-gray text-[18px]">Si te interesa, descarga el ebook y adentro veras como contactarme.</p>
         <Button subtext="👇Link para auditoria dentro del ebook 👇" width='w-full' mdWidth='w-full' useArrow={false} >
                  DESCARGAR EL EBOOK GRATIS
         </Button>
      </div>
    </div>
  </div>
  <div class="absolute bottom-0 left-0 w-full z-20 overflow-hidden transform translate-y-1">
     
     <div class="absolute bottom-0 w-full h-16 md:h-32 bg-gray-300 transform scale-y-105" style="clip-path: polygon(0% 25%, 3% 60%, 8% 30%, 14% 75%, 19% 35%, 26% 70%, 33% 35%, 41% 75%, 46% 35%, 53% 70%, 61% 30%, 68% 75%, 74% 35%, 82% 70%, 89% 30%, 95% 65%, 100% 30%, 100% 100%, 0% 100%)"></div>

     <div class="relative w-full h-12 md:h-24 bg-[#eef5f4]" style="clip-path: polygon(0% 20%, 2% 55%, 6% 25%, 11% 70%, 15% 30%, 21% 65%, 25% 35%, 31% 80%, 38% 25%, 42% 60%, 48% 25%, 54% 75%, 60% 30%, 67% 70%, 72% 30%, 79% 65%, 85% 25%, 92% 70%, 96% 40%, 100% 20%, 100% 100%, 0% 100%)"></div>
  </div>
</section>


